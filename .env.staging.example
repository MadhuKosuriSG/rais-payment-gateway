# Staging Environment Configuration
# Copy this file to .env.staging and update with your actual values

# Rails Environment
RAILS_ENV=staging
RAILS_MAX_THREADS=5

# Database Configuration (TCP/IP Connection)
DATABASE_HOST=your_staging_db_host
DATABASE_PORT=3306
DATABASE_USERNAME=your_staging_db_user
DATABASE_PASSWORD=your_staging_db_password
DATABASE_NAME=rais_payment_gateway_staging

# Razorpay API Credentials (Use test credentials for staging)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Application Settings
APP_HOST=https://your-staging-domain.com
FRONTEND_URL=https://your-staging-frontend.com

# Security
SECRET_KEY_BASE=your_secret_key_base_here

# Optional: If you need to use socket connection instead of TCP/IP
# DATABASE_SOCKET=/path/to/mysql.sock
